{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "okou-g2",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "98b0b14cee451004596479a689d2071b",
  "workers_dev": false,
  "observability": { "enabled": true },
  "routes": [
    {
      "pattern": "g2.okou.ai",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // Clerk production instance for okou.ai. Session tokens are verified against
    // this issuer's public JWKS, so the Worker holds no Clerk secret.
    "CLERK_ISSUER": "https://clerk.okou.ai",
    // Accepted `azp` (authorized party) values on the Clerk session token.
    "ALLOWED_ORIGINS": "https://g2.okou.ai,http://localhost:5173"
  }
}
